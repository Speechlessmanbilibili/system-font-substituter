{
  "manifest_version": 3,
  "name": "System Font Substituter",
  "version": "1.5.2",
  "description": "Replace common Western and Simplified Chinese system/UI fonts while preserving site design fonts, icons, and code fonts.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "System Font Substituter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
